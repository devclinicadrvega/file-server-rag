# API Key para autenticación interna
API_KEY=genera-una-clave-segura-aqui

# S3 Coolify (llenar con los valores de tu S3 en Coolify)
S3_ENDPOINT_URL=https://s3.crm.clinicadrvega.com
S3_ACCESS_KEY_ID=tu-access-key
S3_SECRET_ACCESS_KEY=tu-secret-key
S3_BUCKET_NAME=file-server
S3_REGION=us-east-1
S3_PUBLIC_URL=

# URL pública del servicio
PUBLIC_URL=https://files.crm.clinicadrvega.com

# Configuración
SHARE_TOKEN_HOURS=48
MAX_UPLOAD_MB=50
DEBUG=false
